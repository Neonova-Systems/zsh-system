#!/usr/bin/env zsh
emulate -L zsh; setopt extendedglob warncreateglobal pipefail nounset errreturn
need_installed pwgen wl-copy yad notify-send # Check if command is installed

local password_length="${1:-32}"
local show_password="FALSE"

if [[ -z "${1:-}" ]]; then
	local form_result
	form_result="$(yad --form \
		--title="Generate Random Password" \
		--width=420 \
		--center \
		--separator='|' \
		--field="Length:NUM" "${password_length}!8..256!1" \
		--field="Show password in dialog:CHK" "${show_password}" \
		--button="Generate:0" \
		--button="Cancel:1")" || return 0

	IFS='|' read -r password_length show_password <<< "${form_result}"
fi

[[ "${password_length}" != <-> || "${password_length}" -lt 8 ]] && {
	yad --error --title="Generate Random Password" --text="Password length must be a number >= 8."
	return 1
}

local generated_password
generated_password="$(pwgen -s -y -n -c -1 "${password_length}")" || {
	yad --error --title="Generate Random Password" --text="Failed to generate password."
	return 1
}

print -rn -- "${generated_password}" | wl-copy
notify-send -u critical "$0" "Random password copied to the clipboard!"

if [[ "${show_password:l}" == "true" ]]; then
	yad --info --title="Generate Random Password" --width=520 --text="Password copied to clipboard:\n\n<tt>${generated_password}</tt>"
else
	yad --info --title="Generate Random Password" --text="Random password copied to clipboard!"
fi
