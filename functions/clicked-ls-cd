#!/usr/bin/env zsh
# ╭──────────────────────────────────────────────────────────────────────────────╮
# │   Change into a directory from a clicked link printed by `clicked-ls`         │
# ╰──────────────────────────────────────────────────────────────────────────────╯
emulate -L zsh; setopt extendedglob warncreateglobal nounset

local encoded=${1:-} # First argument is a percent-encoded absolute path
if [[ -z $encoded ]]; then # Check if the path argument is missing
    print -u2 "clicked-ls-cd: no path given" # Report the missing argument
    return 1 # Exit with an error
fi

local decoded=${encoded//\%/\\x} # Turn every % into \x so printf %b can decode it
printf -v decoded '%b' "$decoded" # Percent-decode the path into decoded

if [[ -d $decoded ]]; then # Check if the decoded path is a directory
    builtin cd -- "$decoded" # Change to it using the builtin cd
else
    print -u2 "clicked-ls-cd: not a directory: $decoded" # Report the failure
    return 1 # Exit with an error
fi
